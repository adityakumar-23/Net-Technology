@model Experiment8.Models.ProductFilterViewModel
@{
    ViewData["Title"] = "Product Catalog Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold tracking-tight text-dark mb-1">Product Inventory Catalog</h2>
        <p class="text-muted mb-0 small">Displaying <strong>@Model.TotalCount product(s)</strong> managed through ADO.NET SQL Server queries.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="ExportCsv" asp-route-search="@Model.SearchTerm" asp-route-category="@Model.SelectedCategory" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-xs">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export DataTable
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-xs">
            <i class="bi bi-plus-lg me-1"></i> Add New Product
        </a>
    </div>
</div>

<!-- Search & Filter Controls Toolbar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <!-- Search Input -->
            <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control form-control-sm border-start-0" placeholder="Search by name, supplier..." value="@Model.SearchTerm" />
                </div>
            </div>

            <!-- Category Filter Dropdown -->
            <div class="col-12 col-sm-6 col-md-3">
                <select name="category" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.SelectedCategory == cat)
                        {
                            <option value="@cat" selected="selected">@cat</option>
                        }
                        else
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>

            <!-- Stock Status Filter -->
            <div class="col-12 col-sm-6 col-md-3">
                <select name="stockStatus" class="form-select form-select-sm" onchange="this.form.submit()">
                    <!option value="" @(string.IsNullOrEmpty(Model.SelectedStockStatus) ? "selected" : "")>All Stock Statuses</!option>
                    <!option value="InStock" @(Model.SelectedStockStatus == "InStock" ? "selected" : "")>In Stock (&gt; 10 units)</!option>
                    <!option value="LowStock" @(Model.SelectedStockStatus == "LowStock" ? "selected" : "")>Low Stock (&le; 10 units)</!option>
                    <!option value="OutOfStock" @(Model.SelectedStockStatus == "OutOfStock" ? "selected" : "")>Out of Stock (0 units)</!option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-light btn-sm border text-muted" title="Clear Filters">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Products Table Card -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="card-body p-0">
        @if (Model.Products != null && Model.Products.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Product Information</th>
                            <th>Category</th>
                            <th>Stock Quantity</th>
                            <th>Unit Price</th>
                            <th>Total Value</th>
                            <th>Supplier</th>
                            <th>Date Added</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Products)
                        {
                            <tr class="@(item.Quantity == 0 ? "table-danger bg-opacity-25" : (item.IsLowStock ? "table-warning bg-opacity-10" : ""))">
                                <td class="ps-4 font-monospace text-muted small">#@item.ProductID</td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <a asp-action="Details" asp-route-id="@item.ProductID" class="fw-semibold text-dark text-decoration-none hover-primary">
                                            @item.ProductName
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small class="text-muted text-truncate" style="max-width: 250px;">@item.Description</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.Category</span>
                                </td>
                                <td>
                                    <span class="badge @item.StockStatusBadgeClass">
                                        @item.StockStatusText
                                    </span>
                                </td>
                                <td class="fw-medium text-dark">₹@item.Price.ToString("N2")</td>
                                <td class="fw-bold text-dark">₹@item.TotalValue.ToString("N2")</td>
                                <td class="text-muted small">@item.SupplierName</td>
                                <td class="text-muted small">@item.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-outline-secondary" title="View Product Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ProductID" class="btn btn-outline-primary" title="Edit Product">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ProductID" class="btn btn-outline-danger" title="Delete Product">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle p-4 d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-search text-muted fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark">No Products Found</h5>
                <p class="text-muted small mb-3">No inventory items matched your filter criteria. Try resetting your search filters.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Clear Filters</a>
                    <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">Add New Product</a>
                </div>
            </div>
        }
    </div>

    <!-- Table Footer Summary -->
    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="card-footer bg-light border-top py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
            <div>
                Showing <strong>@Model.Products.Count</strong> of <strong>@Model.TotalCount</strong> items
            </div>
            <div>
                Total Current Page Inventory Value: <strong class="text-dark">₹@Model.Products.Sum(p => p.TotalValue).ToString("N2")</strong>
            </div>
        </div>
    }
</div>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management System</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="d-flex" id="wrapper">
        <!-- Sidebar Navigation -->
        <aside id="sidebar-wrapper" class="bg-dark text-white border-end shadow-sm">
            <div class="sidebar-heading px-4 py-3 d-flex align-items-center border-bottom border-secondary border-opacity-25">
                <div class="brand-icon me-2 rounded-3 p-2 bg-primary text-white d-flex align-items-center justify-content-center shadow-sm">
                    <i class="bi bi-boxes fs-4"></i>
                </div>
                <div>
                    <h5 class="m-0 fw-bold tracking-tight text-white">Inventra</h5>
                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle font-monospace small" style="font-size: 0.65rem;">ADO.NET & SQL</span>
                </div>
            </div>

            <div class="px-3 py-3">
                <small class="text-uppercase text-secondary fw-semibold px-2 mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 0.08em;">Core Navigation</small>
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item">
                        <a class="nav-link text-white-50 d-flex align-items-center py-2 px-3 rounded-2" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-grid-1x2-fill me-3 fs-5"></i>
                            <span class="fw-medium">Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 d-flex align-items-center py-2 px-3 rounded-2" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-box-seam-fill me-3 fs-5"></i>
                            <span class="fw-medium">Products Catalog</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 d-flex align-items-center py-2 px-3 rounded-2" asp-controller="Product" asp-action="Create">
                            <i class="bi bi-plus-circle-fill me-3 fs-5"></i>
                            <span class="fw-medium">Add New Product</span>
                        </a>
                    </li>
                </ul>

                <hr class="border-secondary border-opacity-25 my-3">

                <small class="text-uppercase text-secondary fw-semibold px-2 mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 0.08em;">ADO.NET Tools</small>
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item">
                        <a class="nav-link text-white-50 d-flex align-items-center py-2 px-3 rounded-2" asp-controller="Product" asp-action="ExportCsv">
                            <i class="bi bi-file-earmark-spreadsheet-fill me-3 fs-5 text-success"></i>
                            <span class="fw-medium">Export Data (DataTable)</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 d-flex align-items-center py-2 px-3 rounded-2" href="#sqlModal" data-bs-toggle="modal">
                            <i class="bi bi-database-fill-gear me-3 fs-5 text-warning"></i>
                            <span class="fw-medium">SQL Schema Info</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Sidebar Footer User / Student Card -->
            <div class="sidebar-footer p-3 mt-auto border-top border-secondary border-opacity-25 bg-darker">
                <div class="d-flex align-items-center">
                    <div class="avatar bg-primary text-white rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="overflow-hidden">
                        <p class="mb-0 fw-semibold text-white text-truncate small">Aditya Kumar</p>
                        <p class="mb-0 text-white-50 text-truncate" style="font-size: 0.72rem;">Roll: 92400103296 | CE Sem 5</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Page Content Wrapper -->
        <div id="page-content-wrapper" class="w-100 d-flex flex-column min-vh-100">
            <!-- Top Navbar Header -->
            <header class="navbar navbar-expand-lg navbar-white bg-white border-bottom px-4 py-2 sticky-top shadow-xs">
                <div class="container-fluid p-0">
                    <button class="btn btn-outline-secondary btn-sm me-3 border-0 d-lg-none" id="sidebarToggle">
                        <i class="bi bi-list fs-5"></i>
                    </button>

                    <div class="d-none d-md-flex align-items-center text-muted small">
                        <i class="bi bi-server me-2 text-primary"></i>
                        <span><strong>Database:</strong> InventoryDB &bull; <strong>Engine:</strong> Microsoft SQL Server &bull; <strong>Data Access:</strong> Pure ADO.NET</span>
                    </div>

                    <div class="ms-auto d-flex align-items-center gap-3">
                        <div class="d-none d-sm-block text-end">
                            <small class="text-muted d-block" id="currentDateDisplay">Date Loading...</small>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> ADO.NET Connected
                            </span>
                        </div>
                        <a class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" asp-controller="Product" asp-action="Create">
                            <i class="bi bi-plus-lg"></i>
                            <span>New Product</span>
                        </a>
                    </div>
                </div>
            </header>

            <!-- Main Content Container -->
            <main class="container-fluid px-4 py-4 flex-grow-1">
                <partial name="_AlertMessages" />
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="footer bg-white border-top py-3 px-4 mt-auto">
                <div class="container-fluid d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                    <div>
                        <strong>Experiment 8:</strong> Inventory Management System &bull; <strong>Course:</strong> .NET Technologies (01CE1523)
                    </div>
                    <div>
                        Marwadi University &bull; Built with ASP.NET Core MVC, ADO.NET & SQL Server
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- SQL Schema Modal -->
    <div class="modal fade" id="sqlModal" tabindex="-1" aria-labelledby="sqlModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title d-flex align-items-center gap-2" id="sqlModalLabel">
                        <i class="bi bi-database-fill text-warning"></i> SQL Server Schema (InventoryDB)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-light">
                    <p class="text-muted small mb-2">This SQL script creates the <code>InventoryDB</code> database and <code>Products</code> table used directly by ADO.NET.</p>
                    <pre class="bg-dark text-light p-3 rounded-3 small user-select-all" style="max-height: 400px; overflow-y: auto;">
CREATE DATABASE InventoryDB;
GO
USE InventoryDB;
GO

CREATE TABLE Products (
    ProductID INT IDENTITY(1,1) PRIMARY KEY,
    ProductName NVARCHAR(100) NOT NULL,
    Category NVARCHAR(50) NOT NULL,
    Description NVARCHAR(500) NULL,
    Quantity INT NOT NULL DEFAULT 0,
    Price DECIMAL(18,2) NOT NULL DEFAULT 0.00,
    SupplierName NVARCHAR(100) NOT NULL,
    CreatedDate DATETIME2 NOT NULL DEFAULT GETDATE(),
    CONSTRAINT CK_Products_Quantity CHECK (Quantity >= 0),
    CONSTRAINT CK_Products_Price CHECK (Price > 0)
);
GO

-- Non-clustered index on Category for fast filtering
CREATE NONCLUSTERED INDEX IX_Products_Category ON Products (Category);
GO
                    </pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <a href="~/Database/InventoryDB.sql" download class="btn btn-primary btn-sm">
                        <i class="bi bi-download me-1"></i> Download Script
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model SmartCampusPortal.Models.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
}

<!-- Dashboard Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Smart Campus Dashboard</h3>
        <p class="text-muted mb-0">Real-time overview of student service requests and infrastructure maintenance status.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "ServiceRequest")" class="btn btn-outline-primary btn-sm rounded-3 px-3">
            <i class="fa-solid fa-table-list me-1"></i> View All Requests
        </a>
        <a href="@Url.Action("Create", "ServiceRequest")" class="btn btn-primary btn-sm rounded-3 px-3 shadow-sm">
            <i class="fa-solid fa-circle-plus me-1"></i> Submit Request
        </a>
    </div>
</div>

<!-- 5 Statistics Cards -->
<div class="row g-3 mb-4">
    <!-- Total Requests -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small fw-bold text-uppercase">Total Requests</span>
                <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-dark">@Model.TotalRequests</h2>
            <div class="text-muted small">
                <i class="fa-solid fa-database text-primary me-1"></i> Logged in system
            </div>
        </div>
    </div>

    <!-- Pending Requests -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small fw-bold text-uppercase">Pending</span>
                <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-warning">@Model.PendingRequests</h2>
            <div class="text-muted small">
                <i class="fa-solid fa-clock text-warning me-1"></i> Awaiting review
            </div>
        </div>
    </div>

    <!-- In Progress Requests -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small fw-bold text-uppercase">In Progress</span>
                <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
                    <i class="fa-solid fa-gears"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-info">@Model.InProgressRequests</h2>
            <div class="text-muted small">
                <i class="fa-solid fa-wrench text-info me-1"></i> Under maintenance
            </div>
        </div>
    </div>

    <!-- Completed Requests -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small fw-bold text-uppercase">Completed</span>
                <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-success">@Model.CompletedRequests</h2>
            <div class="text-muted small">
                <i class="fa-solid fa-check-double text-success me-1"></i> Resolved tickets
            </div>
        </div>
    </div>

    <!-- Rejected Requests -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small fw-bold text-uppercase">Rejected</span>
                <div class="stat-icon-wrapper bg-danger bg-opacity-10 text-danger">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-danger">@Model.RejectedRequests</h2>
            <div class="text-muted small">
                <i class="fa-solid fa-ban text-danger me-1"></i> Declined / Invalid
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Status Breakdown Doughnut Chart -->
    <div class="col-lg-5">
        <div class="modern-card h-100">
            <div class="modern-card-header">
                <h5><i class="fa-solid fa-chart-pie text-primary me-2"></i>Status Distribution</h5>
                <span class="badge bg-light text-dark border">Real-time</span>
            </div>
            <div class="p-4 d-flex justify-content-center align-items-center" style="min-height: 280px;">
                <canvas id="statusChart" style="max-height: 240px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Category Breakdown Bar Chart -->
    <div class="col-lg-7">
        <div class="modern-card h-100">
            <div class="modern-card-header">
                <h5><i class="fa-solid fa-chart-simple text-primary me-2"></i>Requests by Service Category</h5>
                <span class="badge bg-light text-dark border">Departmental Load</span>
            </div>
            <div class="p-4" style="min-height: 280px;">
                <canvas id="categoryChart" style="max-height: 240px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Service Activities Table -->
<div class="modern-card mb-4">
    <div class="modern-card-header">
        <div>
            <h5><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Recent Service Activities</h5>
            <small class="text-muted">Latest student requests submitted across campus departments</small>
        </div>
        <a href="@Url.Action("Index", "ServiceRequest")" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            View All <i class="fa-solid fa-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Student Details</th>
                    <th>Category</th>
                    <th>Title & Description</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Request Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentRequests != null && Model.RecentRequests.Any())
                {
                    foreach (var req in Model.RecentRequests)
                    {
                        <tr>
                            <td>
                                <strong class="text-primary">#@req.RequestId</strong>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@req.StudentName</div>
                                <small class="text-muted"><i class="fa-solid fa-building-columns me-1"></i>@req.Department</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-tag me-1 text-primary"></i>@req.ServiceCategory
                                </span>
                            </td>
                            <td style="max-width: 280px;">
                                <div class="fw-semibold text-truncate" title="@req.RequestTitle">@req.RequestTitle</div>
                                <small class="text-muted text-truncate d-block" title="@req.Description">@req.Description</small>
                            </td>
                            <td>
                                @if (req.Priority == "High")
                                {
                                    <span class="priority-high"><i class="fa-solid fa-triangle-exclamation me-1"></i>High</span>
                                }
                                else if (req.Priority == "Medium")
                                {
                                    <span class="priority-medium"><i class="fa-solid fa-circle-dot me-1"></i>Medium</span>
                                }
                                else
                                {
                                    <span class="priority-low"><i class="fa-solid fa-arrow-down me-1"></i>Low</span>
                                }
                            </td>
                            <td>
                                @if (req.Status == "Pending")
                                {
                                    <span class="badge-pending"><i class="fa-solid fa-hourglass me-1"></i>Pending</span>
                                }
                                else if (req.Status == "In Progress")
                                {
                                    <span class="badge-progress"><i class="fa-solid fa-spinner me-1"></i>In Progress</span>
                                }
                                else if (req.Status == "Completed")
                                {
                                    <span class="badge-completed"><i class="fa-solid fa-check me-1"></i>Completed</span>
                                }
                                else
                                {
                                    <span class="badge-rejected"><i class="fa-solid fa-xmark me-1"></i>Rejected</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@req.RequestDate.ToString("dd MMM yyyy, hh:mm tt")</small>
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Details", "ServiceRequest", new { id = req.RequestId })" class="btn btn-outline-secondary btn-sm" title="View Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a href="@Url.Action("UpdateStatus", "ServiceRequest", new { id = req.RequestId })" class="btn btn-outline-primary btn-sm ms-1" title="Update Status">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-inbox fs-3 d-block mb-2 text-muted"></i>
                            No service requests logged yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Status Doughnut Chart
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Pending', 'In Progress', 'Completed', 'Rejected'],
                datasets: [{
                    data: [
                        @Model.PendingRequests,
                        @Model.InProgressRequests,
                        @Model.CompletedRequests,
                        @Model.RejectedRequests
                    ],
                    backgroundColor: [
                        '#f59e0b',
                        '#0284c7',
                        '#10b981',
                        '#ef4444'
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 12,
                            padding: 15,
                            font: { family: "'Plus Jakarta Sans', sans-serif", size: 12 }
                        }
                    }
                },
                cutout: '68%'
            }
        });

        // Category Bar Chart
        const catCtx = document.getElementById('categoryChart').getContext('2d');
        const catLabels = [];
        const catData = [];

        @foreach (var kvp in Model.CategoryCounts)
        {
            <text>
            catLabels.push('@Html.Raw(HttpUtility.JavaScriptStringEncode(kvp.Key))');
            catData.push(@kvp.Value);
            </text>
        }

        new Chart(catCtx, {
            type: 'bar',
            data: {
                labels: catLabels.length > 0 ? catLabels : ['IT Support', 'Hostel', 'Electrical', 'Classroom', 'Library'],
                datasets: [{
                    label: 'Service Requests',
                    data: catData.length > 0 ? catData : [1, 1, 1, 1, 1],
                    backgroundColor: 'rgba(37, 99, 235, 0.85)',
                    borderRadius: 6,
                    maxBarThickness: 38
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, precision: 0 },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    });
</script>
}

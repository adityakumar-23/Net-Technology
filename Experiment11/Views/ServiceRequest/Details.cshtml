@model SmartCampusPortal.Models.ServiceRequest
@{
    ViewBag.Title = "Request #" + Model.RequestId + " Details";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="fw-bold mb-0 text-dark">Service Request #@Model.RequestId</h3>
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge-pending"><i class="fa-solid fa-hourglass me-1"></i>Pending</span>
                    }
                    else if (Model.Status == "In Progress")
                    {
                        <span class="badge-progress"><i class="fa-solid fa-spinner me-1"></i>In Progress</span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span class="badge-completed"><i class="fa-solid fa-check me-1"></i>Completed</span>
                    }
                    else
                    {
                        <span class="badge-rejected"><i class="fa-solid fa-xmark me-1"></i>Rejected</span>
                    }
                </div>
                <small class="text-muted"><i class="fa-solid fa-calendar-days me-1"></i>Submitted on @Model.RequestDate.ToString("dd MMMM yyyy, hh:mm tt")</small>
            </div>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                </a>
                <a href="@Url.Action("UpdateStatus", new { id = Model.RequestId })" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-sliders me-1"></i> Update Status
                </a>
                <a href="@Url.Action("Edit", new { id = Model.RequestId })" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-pencil me-1"></i> Edit Request
                </a>
            </div>
        </div>

        <!-- Details Card -->
        <div class="modern-card p-4 mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-3 mb-4">
                <i class="fa-solid fa-circle-info text-primary me-2"></i>Ticket Information
            </h5>

            <div class="row g-4">
                <!-- Request Title -->
                <div class="col-12">
                    <label class="text-muted small fw-bold text-uppercase d-block">Request Title</label>
                    <h4 class="fw-bold text-dark mb-0">@Model.RequestTitle</h4>
                </div>

                <!-- Description -->
                <div class="col-12">
                    <label class="text-muted small fw-bold text-uppercase d-block mb-1">Issue Description</label>
                    <div class="p-3 bg-light rounded-3 text-secondary" style="white-space: pre-line;">
                        @Model.Description
                    </div>
                </div>

                <!-- Service Category -->
                <div class="col-md-4">
                    <label class="text-muted small fw-bold text-uppercase d-block">Service Category</label>
                    <span class="badge bg-light text-dark border fs-6 mt-1">
                        <i class="fa-solid fa-tag text-primary me-1"></i>@Model.ServiceCategory
                    </span>
                </div>

                <!-- Priority -->
                <div class="col-md-4">
                    <label class="text-muted small fw-bold text-uppercase d-block">Priority</label>
                    <div class="mt-1 fs-6">
                        @if (Model.Priority == "High")
                        {
                            <span class="priority-high"><i class="fa-solid fa-triangle-exclamation me-1"></i>High Priority</span>
                        }
                        else if (Model.Priority == "Medium")
                        {
                            <span class="priority-medium"><i class="fa-solid fa-circle-dot me-1"></i>Medium Priority</span>
                        }
                        else
                        {
                            <span class="priority-low"><i class="fa-solid fa-arrow-down me-1"></i>Low Priority</span>
                        }
                    </div>
                </div>

                <!-- Current Status -->
                <div class="col-md-4">
                    <label class="text-muted small fw-bold text-uppercase d-block">Current Status</label>
                    <div class="mt-1">
                        <strong>@Model.Status</strong>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold text-dark border-bottom pb-3 mb-4 mt-5">
                <i class="fa-solid fa-user-graduate text-primary me-2"></i>Student Details
            </h5>

            <div class="row g-4">
                <div class="col-md-4">
                    <label class="text-muted small fw-bold text-uppercase d-block">Student Name</label>
                    <div class="fw-bold text-dark mt-1">@Model.StudentName</div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small fw-bold text-uppercase d-block">Student Email</label>
                    <div class="text-dark mt-1"><a href="mailto:@Model.StudentEmail">@Model.StudentEmail</a></div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small fw-bold text-uppercase d-block">Department</label>
                    <div class="text-dark mt-1"><i class="fa-solid fa-building-columns text-secondary me-1"></i>@Model.Department</div>
                </div>
            </div>

            <!-- Admin Remarks Section -->
            <h5 class="fw-bold text-dark border-bottom pb-3 mb-4 mt-5">
                <i class="fa-solid fa-clipboard-check text-primary me-2"></i>Administration & Resolution
            </h5>

            <div class="row g-3">
                <div class="col-12">
                    <label class="text-muted small fw-bold text-uppercase d-block mb-1">Administrative Remarks / Technician Notes</label>
                    @if (!string.IsNullOrEmpty(Model.AdminRemarks))
                    {
                        <div class="p-3 rounded-3 border-start border-4 border-info bg-light text-dark">
                            <i class="fa-solid fa-comment-dots text-info me-2"></i>@Model.AdminRemarks
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-3 bg-light text-muted fst-italic">
                            No administrative remarks recorded yet. You can add resolution remarks via the <a href="@Url.Action("UpdateStatus", new { id = Model.RequestId })">Update Status</a> panel.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@model SmartCampusPortal.Models.ServiceRequest
@{
    ViewBag.Title = "Delete Service Request #" + Model.RequestId;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-danger">Delete Service Request</h3>
                <p class="text-muted mb-0">Please confirm deletion of this ticket from the campus database.</p>
            </div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="modern-card p-4 border-danger">
            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <i class="fa-solid fa-triangle-exclamation fs-3 text-warning me-3"></i>
                <div>
                    <strong>Warning:</strong> Are you sure you want to delete this service request? This action will permanently remove ticket <strong>#@Model.RequestId</strong> from SQL Server.
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 mb-4">
                <div class="row g-2">
                    <div class="col-sm-4 text-muted small fw-bold">Ticket ID:</div>
                    <div class="col-sm-8 fw-bold text-dark">#@Model.RequestId</div>

                    <div class="col-sm-4 text-muted small fw-bold">Student Name:</div>
                    <div class="col-sm-8 text-dark">@Model.StudentName (@Model.Department)</div>

                    <div class="col-sm-4 text-muted small fw-bold">Category:</div>
                    <div class="col-sm-8 text-dark">@Model.ServiceCategory</div>

                    <div class="col-sm-4 text-muted small fw-bold">Request Title:</div>
                    <div class="col-sm-8 text-dark">@Model.RequestTitle</div>

                    <div class="col-sm-4 text-muted small fw-bold">Status:</div>
                    <div class="col-sm-8 text-dark">@Model.Status</div>

                    <div class="col-sm-4 text-muted small fw-bold">Date Logged:</div>
                    <div class="col-sm-8 text-muted">@Model.RequestDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                </div>
            </div>

            @using (Html.BeginForm("Delete", "ServiceRequest", new { id = Model.RequestId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4 shadow-sm">
                        <i class="fa-solid fa-trash-can me-1"></i> Confirm Delete
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Experiment9.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Placement Management Dashboard</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="CSS/site.css" />
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light">
    <form id="mainForm" runat="server">
        <asp:ScriptManager ID="smGlobal" runat="server" EnablePartialRendering="true" />

        <div class="d-flex" id="wrapper">
            <!-- Sidebar Navigation -->
            <aside id="sidebar-wrapper" class="bg-dark text-white border-end shadow-sm">
                <div class="sidebar-heading px-4 py-3 d-flex align-items-center border-bottom border-secondary border-opacity-25">
                    <div class="brand-icon me-2 rounded-3 p-2 bg-primary text-white d-flex align-items-center justify-content-center shadow-sm">
                        <i class="bi bi-mortarboard-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="m-0 fw-bold tracking-tight text-white">PlaceTrack</h5>
                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle font-monospace small" style="font-size: 0.65rem;">ASP.NET Data Controls</span>
                    </div>
                </div>

                <div class="px-3 py-3">
                    <small class="text-uppercase text-secondary fw-semibold px-2 mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 0.08em;">Navigation</small>
                    <ul class="nav nav-pills flex-column gap-1">
                        <li class="nav-item">
                            <a class="nav-link text-white-50 d-flex align-items-center py-2 px-3 rounded-2" href="Default.aspx">
                                <i class="bi bi-grid-1x2-fill me-3 fs-5"></i>
                                <span class="fw-medium">Dashboard (Repeater)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 d-flex align-items-center py-2 px-3 rounded-2" href="Students.aspx">
                                <i class="bi bi-people-fill me-3 fs-5"></i>
                                <span class="fw-medium">Students (GridView, Details, Form)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 d-flex align-items-center py-2 px-3 rounded-2" href="Companies.aspx">
                                <i class="bi bi-buildings-fill me-3 fs-5"></i>
                                <span class="fw-medium">Companies (DataList)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 d-flex align-items-center py-2 px-3 rounded-2" href="Placements.aspx">
                                <i class="bi bi-award-fill me-3 fs-5"></i>
                                <span class="fw-medium">Placement Offers</span>
                            </a>
                        </li>
                    </ul>

                    <hr class="border-secondary border-opacity-25 my-3" />

                    <small class="text-uppercase text-secondary fw-semibold px-2 mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 0.08em;">5 Data Controls Showcase</small>
                    <div class="d-flex flex-column gap-1 px-2 small text-secondary">
                        <div class="d-flex align-items-center gap-2 py-1"><i class="bi bi-table text-primary"></i> <span>1. GridView (Paging, Sort, Edit)</span></div>
                        <div class="d-flex align-items-center gap-2 py-1"><i class="bi bi-card-heading text-info"></i> <span>2. DetailsView (Record Navigate)</span></div>
                        <div class="d-flex align-items-center gap-2 py-1"><i class="bi bi-input-cursor text-success"></i> <span>3. FormView (Custom Template)</span></div>
                        <div class="d-flex align-items-center gap-2 py-1"><i class="bi bi-repeat text-warning"></i> <span>4. Repeater (Activities Feed)</span></div>
                        <div class="d-flex align-items-center gap-2 py-1"><i class="bi bi-grid text-danger"></i> <span>5. DataList (Card Catalog)</span></div>
                    </div>
                </div>

                <!-- Sidebar Footer User / Student Card -->
                <div class="sidebar-footer p-3 mt-auto border-top border-secondary border-opacity-25 bg-darker">
                    <div class="d-flex align-items-center">
                        <div class="avatar bg-primary text-white rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="overflow-hidden">
                            <p class="mb-0 fw-semibold text-white text-truncate small">Aditya Kumar</p>
                            <p class="mb-0 text-white-50 text-truncate" style="font-size: 0.72rem;">Roll: 92400103296 | CE Sem 5</p>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Page Content Wrapper -->
            <div id="page-content-wrapper" class="w-100 d-flex flex-column min-vh-100">
                <!-- Top Navbar Header -->
                <header class="navbar navbar-expand-lg navbar-white bg-white border-bottom px-4 py-2 sticky-top shadow-xs">
                    <div class="container-fluid p-0">
                        <button class="btn btn-outline-secondary btn-sm me-3 border-0 d-lg-none" id="sidebarToggle" type="button">
                            <i class="bi bi-list fs-5"></i>
                        </button>

                        <div class="d-none d-md-flex align-items-center text-muted small">
                            <i class="bi bi-database-check me-2 text-primary"></i>
                            <span><strong>Database:</strong> PlacementDB &bull; <strong>Technology:</strong> ASP.NET Web Forms &bull; <strong>Controls:</strong> 5 Data Controls</span>
                        </div>

                        <div class="ms-auto d-flex align-items-center gap-3">
                            <div class="d-none d-sm-block text-end">
                                <small class="text-muted d-block" id="topLiveDate">Today</small>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> SQL Server Online
                                </span>
                            </div>
                            <a href="Students.aspx#tabForm" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1">
                                <i class="bi bi-person-plus-fill"></i>
                                <span>Register Student</span>
                            </a>
                        </div>
                    </div>
                </header>

                <!-- Global Dismissible Notifications -->
                <asp:Panel ID="pnlAlert" runat="server" Visible="false" CssClass="container-fluid px-4 pt-3">
                    <div class="alert alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-0" id="divAlertBox" runat="server">
                        <i id="iconAlert" runat="server" class="bi bi-info-circle-fill fs-5 me-2"></i>
                        <div class="flex-grow-1">
                            <asp:Label ID="lblAlertMessage" runat="server"></asp:Label>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </asp:Panel>

                <!-- Main Content Container -->
                <main class="container-fluid px-4 py-4 flex-grow-1">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

                <!-- Footer -->
                <footer class="footer bg-white border-top py-3 px-4 mt-auto">
                    <div class="container-fluid d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                        <div>
                            <strong>Experiment 9:</strong> Placement Management Dashboard &bull; <strong>Course:</strong> .NET Technologies (01CE1523)
                        </div>
                        <div>
                            Marwadi University &bull; Built with ASP.NET Web Forms, ADO.NET & SQL Server
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </form>

    <!-- Bootstrap 5 JavaScript Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom Theme JS -->
    <script src="JavaScript/site.js"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>


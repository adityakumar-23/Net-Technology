<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Feedback Hub</title>
    
    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap 5 & Site Custom Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Feedback" asp-action="Index">
                    <span class="brand-icon-wrapper">
                        <i class="bi bi-chat-heart-fill"></i>
                    </span>
                    <div class="d-flex flex-column">
                        <span class="brand-title">FeedbackHub</span>
                    </div>
                    <span class="brand-badge ms-1">MVC Module</span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Feedback" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                               asp-controller="Feedback" asp-action="Index">
                                <i class="bi bi-grid-1x2-fill me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Feedback" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" 
                               asp-controller="Feedback" asp-action="Create">
                                <i class="bi bi-pencil-square me-1"></i> Submit Feedback
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Feedback" asp-action="Create" class="btn btn-primary-custom d-flex align-items-center gap-2">
                            <i class="bi bi-plus-circle-fill"></i>
                            <span>New Feedback</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <!-- Render Global Alert Partial View -->
        @await Html.PartialAsync("_AlertBanner")

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0 fw-medium">
                        &copy; @DateTime.Now.Year <strong>FeedbackHub</strong> - MVC Layout, Partial View &amp; Validation Showcase.
                    </p>
                    <small class="text-muted">Built with ASP.NET Core MVC, Strongly-Typed HTML Helpers &amp; Unobtrusive Validation.</small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item">
                            <a asp-controller="Feedback" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a>
                        </li>
                        <li class="list-inline-item text-muted">&bull;</li>
                        <li class="list-inline-item">
                            <a asp-controller="Feedback" asp-action="Create" class="text-decoration-none text-muted">Submit Feedback</a>
                        </li>
                        <li class="list-inline-item text-muted">&bull;</li>
                        <li class="list-inline-item">
                            <span class="badge bg-light text-secondary border">Experiment 7</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model Experiment7.Models.FeedbackModel

<div class="col-md-6 col-lg-4">
    <div class="app-card app-card-hover h-100 d-flex flex-column fade-in">
        <!-- Card Header -->
        <div class="app-card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="badge-status @(Model.Status switch {
                    Experiment7.Models.FeedbackStatus.New => "badge-status-new",
                    Experiment7.Models.FeedbackStatus.UnderReview => "badge-status-underreview",
                    Experiment7.Models.FeedbackStatus.Resolved => "badge-status-resolved",
                    _ => "badge-status-archived"
                })">
                    <span class="sentiment-dot @(Model.Sentiment switch {
                        Experiment7.Models.SentimentType.Positive => "sentiment-positive",
                        Experiment7.Models.SentimentType.Neutral => "sentiment-neutral",
                        _ => "sentiment-negative"
                    })"></span>
                    @Model.Status
                </span>
            </div>
            <small class="text-muted font-monospace">#@Model.Id.ToString("D4")</small>
        </div>

        <!-- Card Body -->
        <div class="app-card-body flex-grow-1 d-flex flex-column">
            <!-- User Info & Avatar -->
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm flex-shrink-0"
                     style="width: 44px; height: 44px; background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);">
                    @(!string.IsNullOrEmpty(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpper() : "U")
                </div>
                <div class="overflow-hidden">
                    <h6 class="mb-0 fw-bold text-dark text-truncate" title="@Model.FullName">@Model.FullName</h6>
                    <small class="text-muted d-block text-truncate" title="@Model.Email">
                        <i class="bi bi-envelope me-1"></i>@Model.Email
                    </small>
                </div>
            </div>

            <!-- Category & Star Rating -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <span class="badge-category text-truncate" style="max-width: 180px;" title="@Model.Category">
                    <i class="bi bi-tag-fill me-1 text-primary"></i>@Model.Category
                </span>
                <div class="star-display" title="@Model.Rating out of 5 stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Model.Rating)
                        {
                            <span>&#9733;</span>
                        }
                        else
                        {
                            <span class="star-empty">&#9733;</span>
                        }
                    }
                </div>
            </div>

            <!-- Quote/Comments -->
            <div class="feedback-card-quote flex-grow-1">
                <p class="mb-0 fst-italic">
                    "@(Model.Comments.Length > 140 ? Model.Comments.Substring(0, 140) + "..." : Model.Comments)"
                </p>
            </div>

            <!-- Recommendation & Timestamp -->
            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                @if (Model.WouldRecommend)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                        <i class="bi bi-hand-thumbs-up-fill"></i> Recommends
                    </span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1">
                        <i class="bi bi-hand-thumbs-down-fill"></i> Not Recommended
                    </span>
                }
                <small class="text-muted" title="@Model.CreatedAt.ToString("g")">
                    <i class="bi bi-clock me-1"></i>@Model.CreatedAt.ToString("MMM dd, yyyy")
                </small>
            </div>
        </div>

        <!-- Card Footer Actions -->
        <div class="app-card-footer d-flex align-items-center justify-content-between bg-light">
            <div class="btn-group btn-group-sm">
                <!-- Status quick update form -->
                <form asp-controller="Feedback" asp-action="UpdateStatus" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    
                    <div class="dropdown d-inline">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Status
                        </button>
                        <ul class="dropdown-menu shadow-sm">
                            <li><h6 class="dropdown-header">Update Ticket Status</h6></li>
                            <li>
                                <button type="submit" name="status" value="@Experiment7.Models.FeedbackStatus.New" class="dropdown-item d-flex align-items-center gap-2">
                                    <span class="sentiment-dot sentiment-positive"></span> New
                                </button>
                            </li>
                            <li>
                                <button type="submit" name="status" value="@Experiment7.Models.FeedbackStatus.UnderReview" class="dropdown-item d-flex align-items-center gap-2">
                                    <span class="sentiment-dot sentiment-neutral"></span> Under Review
                                </button>
                            </li>
                            <li>
                                <button type="submit" name="status" value="@Experiment7.Models.FeedbackStatus.Resolved" class="dropdown-item d-flex align-items-center gap-2">
                                    <span class="sentiment-dot sentiment-positive"></span> Resolved
                                </button>
                            </li>
                        </ul>
                    </div>
                </form>
            </div>

            <div class="d-flex align-items-center gap-1">
                @* HTML Helper: ActionLink to Details *@
                @Html.ActionLink("Details", "Details", "Feedback", new { id = Model.Id }, new { @class = "btn btn-sm btn-outline-primary fw-semibold" })

                <!-- Delete Action via POST form with confirm -->
                <form asp-controller="Feedback" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete feedback #@Model.Id from @Model.FullName?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-action-icon delete" title="Delete Feedback">
                        <i class="bi bi-trash3-fill"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
